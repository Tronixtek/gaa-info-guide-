{
  "name": "scholar-zone-api",
  "private": true,
  "description": "Checkout API: order creation, Paystack verification, webhooks and signed downloads.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:init": "wrangler d1 execute scholar-zone-orders --file=./schema.sql --remote",
    "db:init:local": "wrangler d1 execute scholar-zone-orders --file=./schema.sql --local",
    "tail": "wrangler tail"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "typescript": "^5.5.4",
    "wrangler": "^3.99.0"
  }
}
