# Publishable keys only. Anything prefixed VITE_ is compiled into the browser
# bundle and is publicly readable — never put a secret key here.
# Copy to .env.local and fill in. See docs/payments.md.

# Paystack public key. Safe to expose; it ships in the bundle by design.
VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxx

# Checkout API. Firebase Hosting rewrites /api/** to the `api` function, so
# this is same-origin. SET IT ONLY ONCE THE FUNCTION IS DEPLOYED — while it is
# unset, checkout stays visibly unavailable instead of failing mid-payment.
VITE_API_BASE_URL=/api

# Not yet enabled. Add a key to make the gateway selectable.
# VITE_FLUTTERWAVE_PUBLIC_KEY=
# VITE_STRIPE_PUBLISHABLE_KEY=
# VITE_PAYPAL_CLIENT_ID=
