# Publishable keys only. Anything prefixed VITE_ is compiled into the browser
# bundle and is publicly readable — never put a secret key here.
# Copy to .env.local and fill in. See docs/payments.md.

VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxx
VITE_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxx
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxx
VITE_PAYPAL_CLIENT_ID=xxxxxxxxxxxxxxxx

# Optional. Defaults to /api, which Firebase rewrites to the checkout function.
# VITE_API_BASE_URL=/api
